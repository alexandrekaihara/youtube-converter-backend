  "bugs": {
    "url": "https://github.com/alexandrekaihara/youtube-converter-backend/issues"
  },
  "homepage": "https://github.com/alexandrekaihara/youtube-converter-backend#readme",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
