{
  "name": "youtube-converter-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "A high-performance, scalable backend service for converting YouTube videos to audio or video formats. This service acts as a lightweight API layer that retrieves available download formats and streaming URLs from videos, which are then processed client-side by the frontend application.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrekaihara/youtube-converter-backend.git"
  },
  "keywords": [],
